set_instance_assignment -name PRESERVE_REGISTER ON -to "emu:emu|system573_top:u_s573|atapi:u_atapi|r_status[5]"
set_instance_assignment -name PRESERVE_REGISTER ON -to "emu:emu|system573_top:u_s573|atapi:u_atapi|r_status[6]"
set_instance_assignment -name PRESERVE_REGISTER ON -to "emu:emu|system573_top:u_s573|atapi:u_atapi|r_status[7]"
set_instance_assignment -name PRESERVE_REGISTER ON -to "emu:emu|system573_top:u_s573|atapi:u_atapi|r_ireason[0]"
set_instance_assignment -name PRESERVE_REGISTER ON -to "emu:emu|system573_top:u_s573|atapi:u_atapi|r_ireason[1]"
