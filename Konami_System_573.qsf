set_instance_assignment -name PRESERVE_REGISTER ON -to "emu:emu|system573_top:u_s573|atapi:u_atapi|r_status[1]"
set_instance_assignment -name PRESERVE_REGISTER ON -to "emu:emu|system573_top:u_s573|atapi:u_atapi|r_status[2]"
