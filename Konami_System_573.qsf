# =============================================================================
# Konami System 573 - Quartus project (MiSTer / DE10-Nano, Cyclone V).
#
# Build (Quartus 17.0.2; see docs/DEPENDENCIES.md for the Colima/Docker recipe):
#   tools/apply_psx_patches.sh            # apply the psx/ EXP1 widening first
#   quartus_sh --flow compile Konami_System_573
#
# `sys/sys.tcl` (MiSTer framework) sets FAMILY/DEVICE, pulls sys.qip (which makes
# `sys_top` the real top and adds sys_top.sdc), and wires the PRE_FLOW build_id +
# the .sof->.rbf POST step. rtl/emu.sv (a clone of psx/PSX.sv with the 573 EXP1
# deltas) is the `emu` that sys_top instantiates.
# =============================================================================

set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.0.2
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# Emit the MiSTer-loadable .rbf during assembly (upstream PSX.qsf sets this; the
# qsf bypasses sys/sys.tcl's post-flow, so wire the .rbf generation here instead).
set_global_assignment -name GENERATE_RBF_FILE ON

# The vendored PSX core is VHDL-2008 (psx_patches/0003 uses the 2008 `maximum()`);
# upstream sets this in psx/PSX.qsf. Required or the VHDL core won't analyze.
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008

# PSX_MiSTer needs the DDR3 framebuffer path (sys_top gates FB_* on this).
set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"
# 2: builds now run on the native dell box (i5-7500, 4 cores/4 threads, 14 GB RAM) --
# the Mac/Colima 11 GB VM that forced serial synthesis (6 workers OOM'd quartus_map) is
# gone. Under the hub's cap-2 build semaphore, 2 builds x 2 = 4 cores (full, no
# oversubscription); RAM-safe (A&S workers + Fitter peak ~4.6 GB << 14 GB). This only
# speeds Analysis & Synthesis + multi-corner timing (~6 min of ~38); the Fitter place &
# route -- the ~30 min / ~80% bottleneck -- is single-threaded regardless of this value.
# See docs/PHASE4_HARDWARE.md and memory dell-build-box (build-time levers).
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2

# Core RTL (573 fabric + emu.sv + the nested psx/rtl PSX core qips).
set_global_assignment -name QIP_FILE files.qip
set_global_assignment -name SEARCH_PATH rtl

# MiSTer framework: use the PSX core's OWN sys (psx/sys), NOT the repo's sys/.
# emu.sv is a clone of psx/PSX.sv, which targets the (older) Template version in
# psx/sys -- the repo's newer sys/ packs HPS_BUS differently (no fb_en/sl), which
# fails to elaborate against emu.sv. psx/sys/sys.qip is qip-path-relative so it
# resolves its own files correctly (the sys HDL + sys_top.sdc), and it provides
# pll_q17 (= the `pll` PSX.sv instantiates). Device assignments are identical
# between the two sys.tcl files.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name DEVICE_FILTER_PACKAGE UFBGA
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 672
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 7
set_global_assignment -name PRE_FLOW_SCRIPT_FILE "quartus_sh:psx/sys/build_id.tcl"
set_global_assignment -name QIP_FILE psx/sys/sys.qip

# Board PIN assignments. CRITICAL: sys.qip carries the framework HDL + SDC but NO
# pin locations -- those live in psx/sys/sys.tcl + sys_analog.tcl, which upstream
# psx/PSX.qsf `source`s but we can't (their relative file-refs resolve wrong from
# our root and would re-pull the incompatible repo sys/). sys_pins.tcl is the pin
# locations only, extracted from those two files. Without it every board pin
# (SDRAM, HDMI, VGA, ...) auto-places to an arbitrary ball -> SDRAM dead (BIOS
# can't run) and VGA on wrong pins (CRT can't lock). See sys_pins.tcl header.
source sys_pins.tcl

# Timing constraints for the PSX core's video PLL. CRITICAL: psx/PSX.sdc is the
# ONLY place the pll2 -> clk_vid divide-by-5 create_generated_clock and the cross-
# PLL false-paths (pll<->pll2, FPGA_CLK<->pll2, pll_hdmi<->pll2, h2f<-pll2) live.
# sys.qip only brings sys_top.sdc (no pll2/clk_vid). Without PSX.sdc those video
# pixel-clock domain crossings are unconstrained and STA reports large negative
# slack on the core clocks (clk_1x cannot even close to its ~33.8 MHz) -- i.e.
# "0 A&S errors" but a TIMING-FAILED bitstream that misbehaves on silicon. The
# instance paths (emu|pll2|..., emu|pll|..., pll_hdmi|..., sysmem|...) match our
# sys_top->emu hierarchy (emu.sv is the PSX.sv clone). Read AFTER sys_top.sdc.
set_global_assignment -name SDC_FILE psx/PSX.sdc

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"