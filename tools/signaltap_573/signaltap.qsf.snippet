# =============================================================================
# signaltap.qsf.snippet -- QSF additions for the BUILD #9 dual-boundary
# SignalTap probe (BUILD9_PLAN.md Option B: sdram->dma + dma->gpu, 87 bits).
#
# HOW IT BECOMES ACTIVE: this content lives appended in Konami_System_573.qsf
# on the debug branch dbg-signaltap-clut, committed together with
# tools/signaltap_573/clut_race.stp -- the hub launcher (dell_build.sh <ref>)
# builds a pushed git ref, so both files must be committed on the ref built.
# NEVER merge this into feat-flash-load/main: debug-build-only.
#
# REQUIRED SECOND STEP (RUNBOOK 1b): the compiler does NOT read the .stp;
# insertion is driven by the SLD_* expansion generated ON DELL by
#   quartus_stp Konami_System_573 --stp_file tools/signaltap_573/clut_race.stp --enable
# which appends USE_SIGNALTAP_FILE + SLD_NODE_* + CONNECT_TO_SLD_* lines.
#
# NODE PRESERVATION comes from THESE assignments, not RTL edits (vendored
# psx/ stays pristine). All taps below are REGISTERS (no combinational nets
# in the build-9 watch list) -> PRESERVE_REGISTER only, no KEEP /
# PRESERVE_FANOUT_FREE_NODE needed (every tapped reg has live fanout).
#
# NO WILDCARDS: PRESERVE_REGISTER wildcards are SILENTLY IGNORED by Quartus
# 17.0 (Critical Warning 136017; cost one hollow-trigger build 2026-06-10).
# Every assignment is an explicit full per-bit path.
#
# Clock-domain note: DMA_GPU_* (dma.vhd:699-700) and sdram dma_* (sdram.sv
# always @(posedge clk_base), clk_base=clk_1x) are clk1x registers --
# oversampled 2:1 at the clk2x capture clock. rec_textPalY (gpu_poly.vhd:151)
# and the pixelpipeline regs are clk2x-native. NO clk3x node is tapped.
# =============================================================================

# --- enable SignalTap with our pre-authored instance -------------------------
set_global_assignment -name ENABLE_SIGNALTAP ON

# --- build #9: dma->gpu boundary (clk1x registers, dma.vhd:699-700) ----------
set_instance_assignment -name PRESERVE_REGISTER ON -to "emu:emu|psx_mister:psx|psx_top:ipsx_top|dma:idma|DMA_GPU_writeEna"
set_instance_assignment -name PRESERVE_REGISTER ON -to "emu:emu|psx_mister:psx|psx_top:ipsx_top|dma:idma|DMA_GPU_write[0]"
set_instance_assignment -name PRESERVE_REGISTER ON -to "emu:emu|psx_mister:psx|psx_top:ipsx_top|dma:idma|DMA_GPU_write[1]"
set_instance_assignment -name PRESERVE_REGISTER ON -to "emu:emu|psx_mister:psx|psx_top:ipsx_top|dma:idma|DMA_GPU_write[2]"
