<misterromdescription>
	<name>hyperbbc573 (System 573, flash)</name>
	<setname>hyperbbc573</setname>
	<rbf>Konami_System_573</rbf>
	<players>2</players>

	<!-- ROM assembly (unchanged from the working boot config) -->
	<rom index="0" zip="hyperbbc573.zip"><part name="bios.bin" crc="11812ef8"/></rom>
	<rom index="2" zip="hyperbbc573.zip"><part name="flash.bin" crc="638e1e54"/></rom>
	<rom index="3" zip="hyperbbc573.zip"><part name="nvram.bin" crc="8e11d196"/></rom>

	<!-- M48T58 NVRAM persistence (high scores / bookkeeping / install state).
	     Load: AFTER the factory nvram.bin above, Main overlays config/nvram/
	     hyperbbc573.nvm (if present) as a normal index-3 download; tag order
	     matters, keep this below the <rom index="3"> row. Save: OSD "Save
	     settings", or automatically on the next OSD-main-menu visit after the
	     game writes the timekeeper (the core asserts ioctl_upload_req). -->
	<nvram index="3" size="8192"/>

	<!-- Button names + default mapping, in the core's J1 joystick-button order, relabelled
	     to the System 573 JAMMA functions our s573_io reads (matches the corrected emu.sv
	     mapping; deploys WITH the build that lands those RTL fixes):
	       joy[4..7] = JAMMA P1 buttons 1-4   (Hyper Bishi Bashi uses 3 buttons/player)
	       joy[8]    = COIN     (emu.sv: coin_sw = ~{joy2[8],joy[8]})   -- insert coin
	       joy[9]    = START    (JAMMA P1 start; emu.sv p1_ctrl[7])
	       joy[10]   = SERVICE  (emu.sv: service_btn = ~joy[10])
	       joy[11]   = TEST     (emu.sv: test_btn = ~joy[11]; leave idle to boot the game)
	     default= assigns a sensible physical gamepad button to each.
	     (Tunable on-board via OSD "Define buttons".) -->
	<buttons count="3"
	         names="Button 1,Button 2,Button 3,Button 4,Coin,Start,Service,Test"
	         default="Y,B,A,X,Select,Start,L,R"/>
</misterromdescription>
