<!--
  ddrsbm (DDR Solo Bass Mix, GQ894 JAA) -- System 573 DIGITAL-board (k573dio) CD game.
  Modeled on the powyakex/hypbbc2p CD .mgl. Cassette = cassyi = X76F100 (gq894ja.u1, 132 B) +
  DS2401 (gq894ja.u6, 8 B, ioctl index 5). CD = 894jaa02.chd. Boot device = CD-ROM (System573.CFG).
  OBSERVE-FIRST bring-up of the digital board: how far does ddrsbm get on the current core
  (DIO board-detect 0x1234 + X76F100/DS2401 cassette auth + CD) before the stubbed MP3/DIO
  datapath? MP3 audio is NOT expected to work yet -- no MAS3507D decoder, and lamp_out/dio_mp3_*
  dangle at emu.sv:2193-2195. This .mgl exists to find the first real stall point on silicon.
-->
<mistergamedescription>
  <rbf>_Console/Konami_System_573</rbf>
  <setname>System573</setname>
  <file delay="1" type="f" index="0" path="/media/fat/games/System573/573bios.bin"/>
  <file delay="1" type="f" index="2" path="/media/fat/games/System573/flash16m_blank.bin"/>
  <file delay="1" type="f" index="3" path="/media/fat/games/System573/nvram8k_blank.bin"/>
  <file delay="1" type="f" index="4" path="/media/fat/games/System573/ddrsbm.u1"/>
  <file delay="1" type="f" index="5" path="/media/fat/games/System573/ddrsbm.u6"/>
  <file delay="2" type="s" index="1" path="/media/fat/games/System573/ddrsbm.chd"/>
  <file delay="3" type="s" index="4" path="/media/fat/saves/System573/ddrsbm.sav"/>
  <reset delay="1"/>
</mistergamedescription>
