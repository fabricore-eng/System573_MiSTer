# Simulation artifacts
sim/build/
*.vvp
*.vcd

# Quartus build output
output_files/
db/
incremental_db/
*.qws
*.rpt
*.summary
*.pof
*.sof
*.jdi
*.pin
*.done

# Editor / OS
*.swp
.DS_Store

# Local-only config (MiSTer connection, credentials)
/local/*
!/local/*.example

# Copyrighted dumps — never commit. Only dumps/README.md is tracked.
# /dumps/** already excludes everything below; the explicit extension lines are
# belt-and-suspenders so no dump binary can ever be force-added by accident.
/dumps/**
!/dumps/README.md
/dumps/**/*.bin
/dumps/**/*.cue
/dumps/**/*.chd
/dumps/**/*.22g
/dumps/**/*.zip

# Security-cart sim fixtures: $readmemh hex DERIVED from the (gitignored) game
# dumps by sim/gen_secdata.sh. Copyrighted -- regenerable, never commit.
sim/secdata/

# Full-system sim outputs
sim/system/out/
*.rbf

# NVC sim build artifacts
sim/nvc/build/
sim/system573/build/
sim/system573_ssreplay/build/
sim/gpu_replay/build/
sim/gpu_replay/__pycache__/

# Stray sim outputs if NVC is ever run outside build/ (run.sh cds to build/ itself)
/R:*
/gra_fb_out*.gra
/bios_fetch.log
/exp1_trace.log
/*.ghw

# NVC scratch libs / python cache (created by ad-hoc nvc/python runs)
work/
__pycache__/

# Quartus build artifacts (generated by the Colima/Quartus compile)
output_files/
db/
incremental_db/
hc_output/
.qsys_edit/
*.qpf
build_id.v
jtag.cdf
PLLJ_PLLSPE_INFO.txt
c5_pin_model_dump.txt
s573_check/
s573_check.qsf

# Claude session runtime lock (not project state)
.claude/scheduled_tasks.lock
# MiSTer deploy/test artifacts pulled back from the board (regenerable; not core source)
cfg/
nvram/
snap/
