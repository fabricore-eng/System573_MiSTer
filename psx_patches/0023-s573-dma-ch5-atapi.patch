+   signal DMA_ATA_read_accu   : std_logic_vector(15 downto 0);   -- 573 ATAPI ch5 low half
    signal slowcnt             : integer range 0 to 24;
       
    signal isOn                : std_logic;
@@ -223,6 +231,11 @@
    
    DMA_SPU_readEna   <= '1' when (dmaState = WORKING and fifoOut_NearFull = '0' and activeChannel = 4 and toDevice = '0') else '0';
 
+   -- 573 ATAPI ch5 (psx_patches/0023). Qualified with ce: the wordAccu consume below
+   -- only advances on ce cycles, but the 573 fabric (atapi.v) free-runs on clk1x --
+   -- an un-gated level here would over-drain the sector buffer during pause/savestate.
+   DMA_ATA_readEna   <= '1' when (ce = '1' and dmaState = WORKING and fifoOut_NearFull = '0' and activeChannel = 5 and toDevice = '0') else '0';
+
    readStall <= '1' when (activeChannel = 2 and toDevice = '0' and gpu_dmaRequest = '0') else '0';
 
    chopsize     <= to_unsigned(1, 8) sll to_integer(dmaSettings.D_CHCR(18 downto 16));
@@ -360,9 +373,9 @@
             dmaArray(2).request <= gpu_dmaRequest;
             dmaArray(3).request <= '1';
             dmaArray(4).request <= spu_dmaRequest;
-            dmaArray(5).request <= '0';
+            dmaArray(5).request <= atapi_dmaRequest;   -- 573 ATAPI (psx_patches/0023)
             dmaArray(6).request <= '1';
-            
+
             -- triggers from modules
             triggerDMA <= (others => '0');
             if (dmaArray(0).D_CHCR(28) = '1' or mdec_dmaWriteRequest = '1')  then triggerDMA(0) <= '1'; end if;
@@ -370,6 +383,11 @@
             if (dmaArray(2).D_CHCR(28) = '1' or gpu_dmaRequest = '1')        then triggerDMA(2) <= '1'; end if;
             if (dmaArray(3).D_CHCR(28) = '1')                                then triggerDMA(3) <= '1'; end if;
             if (dmaArray(4).D_CHCR(28) = '1' or spu_dmaRequest = '1')        then triggerDMA(4) <= '1'; end if;
+            -- 573 ATAPI ch5 (psx_patches/0023): the D_CHCR(28) term covers BOTH the
+            -- BIOS's manual arm (CHCR=0x11050100, trigger bit28) AND the chopping
+            -- resume (the chop pause below re-sets bit28; without this line each
+            -- 32-word chop window would pause once and never resume).
+            if (dmaArray(5).D_CHCR(28) = '1' or atapi_dmaRequest = '1')      then triggerDMA(5) <= '1'; end if;
             if (dmaArray(6).D_CHCR(28) = '1')                                then triggerDMA(6) <= '1'; end if;
             
             -- bus read
@@ -466,11 +484,21 @@
             
             if (DMA_SPU_readEna = '1') then
                case (wordAccu) is
-                  when 0 => wordAccu <= 1; 
+                  when 0 => wordAccu <= 1;
                   when 1 => wordAccu <= 0; DMA_SPU_read_accu <= DMA_SPU_read;
                   when others => null;
                end case;
             end if;
+
+            -- 573 ATAPI ch5 16-bit accumulate (psx_patches/0023): LOW half first,
+            -- exactly the SPU pattern above.
+            if (DMA_ATA_readEna = '1') then
+               case (wordAccu) is
+                  when 0 => wordAccu <= 1;
+                  when 1 => wordAccu <= 0; DMA_ATA_read_accu <= DMA_ATA_read;
+                  when others => null;
+               end case;
+            end if;
             
             -- chopping wait
             for i in 0 to 6 loop
@@ -520,8 +548,15 @@
                      dmaSettings.D_CHCR <= dmaArray(triggerchannel).D_CHCR;
                      dmaSettings.D_MADR <= dmaArray(triggerchannel).D_MADR;
                      dmaSettings.D_BCR  <= dmaArray(triggerchannel).D_BCR;
-                     
-                     if (dmaArray(triggerchannel).D_CHCR(0) = '1') then
+
+                     -- 573 ATAPI ch5 (psx_patches/0023) is device->RAM ONLY: force
+                     -- CHCR bit0 clear (and skip the bit0 RAM-read kick below) so the
+                     -- sync1 "bit0=1" arm form cannot turn ch5 into a RAM read.
+                     if (triggerchannel = 5) then
+                        dmaSettings.D_CHCR(0) <= '0';
+                     end if;
+
+                     if (dmaArray(triggerchannel).D_CHCR(0) = '1' and triggerchannel /= 5) then
                         ram_ena  <= '1';
                         ram_Adr  <= std_logic_vector(dmaArray(triggerchannel).D_MADR(22 downto 2)) & "00";
                      end if;
@@ -542,7 +577,10 @@
                   if (activeChannel = 4) then
                      wordAccu <= 1;
                   end if;
-                  
+                  if (activeChannel = 5) then   -- 573 ATAPI: 16-bit device (psx_patches/0023)
+                     wordAccu <= 1;
+                  end if;
+
                   useDataDirect <= '0';
                   if (activeChannel = 0 or activeChannel = 2) then
                      useDataDirect <= '1';
@@ -564,7 +602,9 @@
                      end if;
                   end if;
                   
-                  if (dmaSettings.D_CHCR(8) = '1' and activeChannel /= 3 and activeChannel /= 6) then
+                  -- the 573 BIOS arms ch5 WITH chopping (CHCR=0x11050100, 32-word chop
+                  -- window) -- legal there, so don't flag it (psx_patches/0023).
+                  if (dmaSettings.D_CHCR(8) = '1' and activeChannel /= 3 and activeChannel /= 5 and activeChannel /= 6) then
                      errorCHOP <= '1';
