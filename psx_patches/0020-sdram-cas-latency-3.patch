diff --git a/rtl/sdram.sv b/rtl/sdram.sv
--- a/rtl/sdram.sv
+++ b/rtl/sdram.sv
@@ -101,7 +101,12 @@
 // as bursts of 2 can be done back-to-back, this does not have any latency or bandwidth penalty compared to full 8 word burst
 localparam BURST_CODE          = 3'b001;   
 localparam ACCESS_TYPE         = 1'b0;     // 0=sequential, 1=interleaved
-localparam CAS_LATENCY         = 3'd2;     // 2 for < 100MHz, 3 for >100MHz
+localparam CAS_LATENCY         = 3'd3;     // 2 for < 100MHz, 3 for >100MHz -- clk3x = 101.6064 MHz, so CL2 is OUT OF SPEC.
+                                           // 573 fix (patch 0020): the continuous ch4 flash traffic (the 573 executes from
+                                           // flash) creates write->read turnaround patterns that collect the CL2 margin debt:
+                                           // deterministic low-bit miscapture on GP0 DMA reads (clut 0x7AC0 -> 0x7800/0x7840),
+                                           // capture-proven on silicon (SignalTap, 2026-06-10). CL3 self-propagates through
+                                           // MODE + data_ready_delay* widths/taps; FSM cadence unchanged.
 localparam OP_MODE             = 2'b00;    // only 00 (standard operation) allowed
 localparam NO_WRITE_BURST      = 1'b1;     // 0= write burst enabled, 1=only single access write
 localparam MODE                = {3'b000, NO_WRITE_BURST, OP_MODE, CAS_LATENCY, ACCESS_TYPE, BURST_CODE};
