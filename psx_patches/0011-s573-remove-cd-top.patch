+   -- System 573: the upstream PSX cd_top is the consumer-PlayStation CD-ROM controller.
+   -- The 573 never uses it -- it drives its own ATAPI optical drive via rtl/atapi.v over the
+   -- EXP1 bus, and four independent BIOS scans confirm cd_top is fully dormant. The 573 core
+   -- is ALM/LAB-bound, so we remove cd_top to recover ~2.9k ALMs (cd_top + cd_xa + cd_xa_zigzag)
+   -- for essential 573 logic. The icd_top instantiation is removed and every output it drove is
+   -- tied to its safe idle constant so the rest of psx_top is unchanged and work.cd_top (and the
+   -- cd_xa helpers) optimize away entirely. The cd_top *inputs* (INSTANTSEEK, hasCD, bus_cd_*,
+   -- DMA_CD_readEna, cd_hps_ack/write/data, trackinfo_*, SS_*, etc.) are simply left unread.
+   --
+   -- CRITICAL: SS_Idle_cd and Pause_idle_cd AND into the global SS_idle / Pause_Idle (~lines
+   -- 750/752). They MUST be '1' or savestate/pause never completes and the core hangs.
+   -- region_out is passed straight through from the region input (consumed downstream in emu.sv).
+   --
+   -- icd_top : entity work.cd_top  -- removed for System 573 (frees ~2.9k ALMs)
+   -- port map
+   -- (
+   --    clk1x                => clk1x,
+   --    ce                   => ce,
+   --    reset                => reset_intern,
+   --
+   --    INSTANTSEEK          => INSTANTSEEK,
+   --    FORCECDSPEED         => FORCECDSPEED,
+   --    LIMITREADSPEED       => LIMITREADSPEED,
+   --    hasCD                => hasCD,
+   --    fastCD               => fastCD,
+   --    testSeek             => testSeek,
+   --    pauseOnCDSlow        => pauseOnCDSlow,
+   --    LIDopen              => LIDopen,
+   --    region               => region,
+   --    region_out           => region_out,
+   --
+   --    pauseCD              => pauseCD,
+   --    Pause_idle_cd        => Pause_idle_cd,
+   --    cdSlow               => cdSlow,
+   --    error                => errorCD,
+   --    LBAdisplay           => LBAdisplay,
+   --
+   --    irqOut               => irq_CDROM,
+   --
+   --    spu_tick             => spu_tick,
+   --    cd_left              => cd_left,
+   --    cd_right             => cd_right,
+   --
+   --    mdec_idle            => SS_Idle_mdec,
+   --
+   --    bus_addr             => bus_cd_addr,
+   --    bus_dataWrite        => bus_cd_dataWrite,
+   --    bus_read             => bus_cd_read,
+   --    bus_write            => bus_cd_write,
+   --    bus_dataRead         => bus_cd_dataRead,
+   --
+   --    dma_read             => DMA_CD_readEna,
+   --    dma_readdata         => DMA_CD_read,
+   --
+   --    cd_hps_req           => cd_hps_req,
+   --    cd_hps_lba           => cd_hps_lba,
+   --    cd_hps_lba_sim       => cd_hps_lba_sim,
+   --    cd_hps_ack           => cd_hps_ack,
+   --    cd_hps_write         => cd_hps_write,
+   --    cd_hps_data          => cd_hps_data,
+   --
+   --    trackinfo_data       => trackinfo_data,
+   --    trackinfo_addr       => trackinfo_addr,
+   --    trackinfo_write      => trackinfo_write,
+   --    resetFromCD          => resetFromCD,
+   --
+   --    SS_reset             => SS_reset,
+   --    SS_DataWrite         => SS_DataWrite,
+   --    SS_Adr               => SS_Adr(13 downto 0),
+   --    SS_wren              => SS_wren(13),
+   --    SS_rden              => SS_rden(13),
+   --    SS_DataRead          => SS_DataRead_CD,
+   --    SS_Idle              => SS_Idle_cd
+   -- );
+   region_out           <= region;            -- pass region straight through (used in emu.sv)
+   pauseCD              <= '0';                -- never request a CD pause
+   Pause_idle_cd        <= '1';                -- CRITICAL: keep global Pause_Idle reachable
+   cdSlow               <= '0';
+   errorCD              <= '0';
+   LBAdisplay           <= (others => '0');
+   irq_CDROM            <= '0';
+   cd_left              <= (others => '0');    -- silent into the SPU mixer
+   cd_right             <= (others => '0');
+   bus_cd_dataRead      <= (others => '0');
+   DMA_CD_read          <= (others => '0');    -- DMA_CD_readEna is a cd_top input, left unread
+   cd_hps_req           <= '0';
+   cd_hps_lba           <= (others => '0');
+   cd_hps_lba_sim       <= (others => '0');
+   resetFromCD          <= '0';
+   SS_DataRead_CD       <= (others => '0');
+   SS_Idle_cd           <= '1';                -- CRITICAL: keep global SS_idle reachable
 
    cdslowEna <= cdSlow and cdslowOn;
 
