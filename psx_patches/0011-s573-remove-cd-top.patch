+# System 573: cd_top (consumer-PSX CD-ROM controller) and its cd_xa helpers are removed
+# from psx_top -- the 573 uses its own ATAPI drive over EXP1. These sources are now dead;
+# drop them from the compile so they don't consume ALMs. (See psx_patches/0011.)
+#set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) cd_xa_zigzag.vhd ]
+#set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) cd_xa.vhd ]
+#set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) cd_top.vhd ]
 set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) memctrl.vhd ]
 set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) sio.vhd ]
 set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) spu_ram.vhd ]
