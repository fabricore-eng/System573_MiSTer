+   -- System 573 (psx_patches/0026): the PSX light-gun overlay/sensor paths
+   -- (gpu_crosshair x2 + justifier_sensor x2) are dead weight on this core -- the
+   -- 573 is a JAMMA/JVS arcade board with no PSX controller port and no GunCon/
+   -- Justifier, and its gameplay input comes from the JAMMA register in s573_io.v
+   -- (0x1f400008), never from the PSX pad/gun path. Removing the four instances
+   -- frees ~41 ALM (justifier_sensor 20+21) plus the crosshair overlay logic on
+   -- the ALM/LAB-bound die. Their outputs are tied to benign idle so the GPU
+   -- video-out mux below collapses the gun overlay terms to constant 0:
+   --   overlay_Gun{1,2}_ena = 0  (no crosshair pixel ever drawn)
+   --   Gun{1,2}IRQ10        = 0  (no Justifier IRQ10; psx_top already AND-gates
+   --                              this with joypadN.PadPortJustif, which the 573
+   --                              never sets, so it was already unreachable).
+   overlay_Gun1_ena <= '0';
+   overlay_Gun2_ena <= '0';
+   Gun1IRQ10        <= '0';
+   Gun2IRQ10        <= '0';
 
    overlay_ena <= overlay_error_ena or overlay_lba_ena or overlay_cd_ena or overlay_fps_ena or debugtextDbg_ena or (overlay_Gun1_ena and Gun1CrosshairOn) or (overlay_Gun2_ena and Gun2CrosshairOn);
    
