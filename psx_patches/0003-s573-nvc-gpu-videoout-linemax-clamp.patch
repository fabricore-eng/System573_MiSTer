From: System 573 MiSTer integration
Subject: [PATCH] gpu_videoout_async: clamp negative line-index args (portable)

The video-out FSM computes display line indices from differences such as
(vdispNew - vDisplayStart), (vDisplayEnd - vDisplayStart) and (lineMax - 1/2).
While the GPU display range is still being programmed (and at time 0) these can
go transiently negative, which NVC rejects when passed to to_unsigned() (a fatal
NATURAL-range error; ModelSim tolerates it). Clamp each to >= 0.

Use a plain-VHDL clamp0() function rather than the VHDL-2008 maximum() builtin:
NVC accepts maximum(), but Quartus 17.0's partial VHDL-2008 support does NOT
implement it (confirmed at the .rbf build: 'object maximum is used but not
declared'). clamp0() works in both the NVC sim and the Quartus build, and is
behavior-neutral for valid (non-negative) display ranges. This patch SHIPS in
the .rbf (synthesis-safe).

diff --git a/rtl/gpu_videoout_async.vhd b/rtl/gpu_videoout_async.vhd
index 12a9dbb..37d9bc2 100644
--- a/rtl/gpu_videoout_async.vhd
+++ b/rtl/gpu_videoout_async.vhd
@@ -40,7 +40,17 @@ entity gpu_videoout_async is
 end entity;
 
 architecture arch of gpu_videoout_async is
-   
+
+   -- System 573 (psx_patches/0003): clamp a line/display index difference to >= 0.
+   -- Replaces the VHDL-2008 `maximum(x,0)` builtin, which NVC accepts but Quartus
+   -- 17.0's partial VHDL-2008 support does NOT implement. This plain-VHDL function
+   -- works in both. (The clamp avoids to_unsigned() of a transient negative value
+   -- while the GPU display range is still being programmed -- see the 0003 note.)
+   function clamp0(v : integer) return integer is
+   begin
+      if (v < 0) then return 0; else return v; end if;
+   end function;
+
    -- clk1x -> clkvid
    signal videoout_settings_s2 : tvideoout_settings;
    signal videoout_settings_s1 : tvideoout_settings;
@@ -274,9 +284,9 @@ begin
          end if;
           
          if (videoout_settings.GPUSTAT_VerRes = '1') then
-            lineMax <= (vDisplayEnd - vDisplayStart) * 2;
+            lineMax <= clamp0(vDisplayEnd - vDisplayStart) * 2;
          else
-            lineMax <= vDisplayEnd - vDisplayStart;
+            lineMax <= clamp0(vDisplayEnd - vDisplayStart);
          end if;
          
          vDisplayStart <= to_integer(videoout_settings.vDisplayRange( 9 downto  0));
@@ -420,12 +430,12 @@ begin
                if (isVsync = '0') then
                   if (videoout_settings.GPUSTAT_VerRes = '1') then
                      if (videoout_reports.interlacedDisplayField = '1') then
-                        lineIn <= to_unsigned(((vdispNew - vDisplayStart) * 2) + 1, 9);
+                        lineIn <= to_unsigned(clamp0(vdispNew - vDisplayStart) * 2 + 1, 9);
                      else
-                        lineIn <= to_unsigned((vdispNew - vDisplayStart) * 2, 9);
+                        lineIn <= to_unsigned(clamp0(vdispNew - vDisplayStart) * 2, 9);
                      end if;
                   else
-                     lineIn <= to_unsigned(vdispNew - vDisplayStart, 9);
+                     lineIn <= to_unsigned(clamp0(vdispNew - vDisplayStart), 9);
                   end if;
                end if;
 
@@ -509,12 +519,12 @@ begin
                   if (vdispNew >= vDisplayStart and vdispNew < vDisplayEnd) then
                      if (videoout_settings.GPUSTAT_VerRes = '1') then
                         if ((activeLineLSBMuxed xor videoout_settings.vramRange(10)) = '1') then
-                           nextLineCalc := to_unsigned(((vdispNew - vDisplayStart) * 2) + 1, 9);
+                           nextLineCalc := to_unsigned(clamp0(vdispNew - vDisplayStart) * 2 + 1, 9);
                         else
-                           nextLineCalc := to_unsigned((vdispNew - vDisplayStart) * 2, 9);
+                           nextLineCalc := to_unsigned(clamp0(vdispNew - vDisplayStart) * 2, 9);
                         end if;
                      else
-                        nextLineCalc := to_unsigned(vdispNew - vDisplayStart, 9);
+                        nextLineCalc := to_unsigned(clamp0(vdispNew - vDisplayStart), 9);
                      end if;
                      videoout_request.fetch      <= not savestate_pause;
                   end if;
@@ -522,9 +532,9 @@ begin
                   if (vdispNew = vtotal) then
                      if (rotate180 = '1') then
                         if (videoout_settings.GPUSTAT_VerRes = '1' and interlacedDisplayFieldMuxed = '1') then
-                           nextLineCalc := to_unsigned((lineMax - 2), 9);
+                           nextLineCalc := to_unsigned(clamp0(lineMax - 2), 9);
                         else
-                           nextLineCalc := to_unsigned((lineMax - 1), 9);
+                           nextLineCalc := to_unsigned(clamp0(lineMax - 1), 9);
                         end if;
                      else
                         if (videoout_settings.GPUSTAT_VerRes = '1' and interlacedDisplayFieldMuxed = '1') then
@@ -537,12 +547,12 @@ begin
                   elsif (vdispNew >= vDisplayStart and vdispNew < vDisplayEnd) then
                      if (videoout_settings.GPUSTAT_VerRes = '1') then
                         if ((activeLineLSBMuxed xor videoout_settings.vramRange(10)) = '1') then
-                           nextLineCalc := to_unsigned(((vdispNew - vDisplayStart) * 2) + 1, 9);
+                           nextLineCalc := to_unsigned(clamp0(vdispNew - vDisplayStart) * 2 + 1, 9);
                         else
-                           nextLineCalc := to_unsigned((vdispNew - vDisplayStart) * 2, 9);
+                           nextLineCalc := to_unsigned(clamp0(vdispNew - vDisplayStart) * 2, 9);
                         end if;
                      else
-                        nextLineCalc := to_unsigned(vdispNew - vDisplayStart, 9);
+                        nextLineCalc := to_unsigned(clamp0(vdispNew - vDisplayStart), 9);
                      end if;
                      videoout_request.fetch      <= not savestate_pause;
                   end if;
@@ -550,7 +560,7 @@ begin
                nextLineCalcSaved <= nextLineCalc;
                
                if (rotate180 = '1') then
-                  videoout_request.lineInNext <= to_unsigned((lineMax - 1), 9) - nextLineCalc;
+                  videoout_request.lineInNext <= to_unsigned(clamp0(lineMax - 1), 9) - nextLineCalc;
                else
                   videoout_request.lineInNext <= nextLineCalc;
                end if;
@@ -681,7 +691,7 @@ begin
                   videoout_out.hblank         <= '1';
                   videoout_reports.hblank_tmr <= '1';
                   
-                  nextLineCalc := to_unsigned((lineMax - 1), 9) - lineIn;
+                  nextLineCalc := to_unsigned(clamp0(lineMax - 1), 9) - lineIn;
                   
                   if ((rotate180 = '1' and nextLineCalc /= videoout_request.lineDisp) or (rotate180 = '0' and lineIn /= videoout_request.lineDisp)) then
                      state <= WAITHBLANKEND;
