diff --git a/rtl/sdram.sv b/rtl/sdram.sv
--- a/rtl/sdram.sv
+++ b/rtl/sdram.sv
@@ -74,7 +74,15 @@
 	input      [3:0]   ch3_be,
 	output reg         ch3_ready,
 
-	input      [26:0]  dmafifo_adr,   
+	// ch4: System 573 onboard-flash line fill (read-only, 128-bit burst, lowest
+	// arbiter priority -- serviced after ch1/ch2/ch3 and refresh). One request
+	// returns a 16-byte (8-word) burst into ch4_dout; ch4_ready pulses when valid.
+	input      [26:0]  ch4_addr,    // 16-bit word addr<<1 of the burst base
+	output reg [127:0] ch4_dout,    // 128-bit data output (flash line half)
+	input              ch4_req,     // request (read only)
+	output reg         ch4_ready,
+
+	input      [26:0]  dmafifo_adr,
 	input      [31:0]  dmafifo_data, 
 	input              dmafifo_empty, 
 	output reg         dmafifo_read
@@ -153,6 +161,7 @@
    ch1_ready <= ch1_ready_ramclock;
 	ch2_ready <= ch2_ready_ramclock;
 	ch3_ready <= ch3_ready_ramclock;
+	ch4_ready <= ch4_ready_ramclock;
 
 	dma_reqprocessed <= dma_reqprocessed_ramclock;
    
@@ -195,6 +204,7 @@
 reg ch1_ready_ramclock = 0;
 reg ch2_ready_ramclock = 0;
 reg ch3_ready_ramclock = 0;
+reg ch4_ready_ramclock = 0;
 reg refreshForce_1 = 0;
 
 reg cache_buffer      = 0;
@@ -216,18 +226,18 @@
 
 reg  [3:0] state = STATE_STARTUP;
 
-reg ch1_rq, ch2_rq, ch3_rq, refreshForce_req;
+reg ch1_rq, ch2_rq, ch3_rq, ch4_rq, refreshForce_req;
 reg saved_wr;
 reg saved_128read = 0;
 
-reg [CAS_LATENCY+BURST_LENGTH:0] data_ready_delay1, data_ready_delay2, data_ready_delay3;
+reg [CAS_LATENCY+BURST_LENGTH:0] data_ready_delay1, data_ready_delay2, data_ready_delay3, data_ready_delay4;
 
 reg [12:0] cas_addr;
 reg [31:0] saved_data;
 reg  [3:0] saved_be;
 reg [15:0] dq_reg;
 
-reg [1:0] ch;
+reg [2:0] ch;
 
 always @(posedge clk) begin
   
@@ -238,7 +248,8 @@
 	ch1_rq <= ch1_rq | (ch1_req & clk3xIndex);
 	ch2_rq <= ch2_rq | (ch2_req & clk3xIndex);
 	ch3_rq <= ch3_rq | (ch3_req & clk3xIndex);
-   
+	ch4_rq <= ch4_rq | (ch4_req & clk3xIndex);
+
    ch3buf_addr <= ch3_addr;
    ch3buf_din  <= ch3_din;
    ch3buf_rnw  <= ch3_rnw;
@@ -247,7 +258,8 @@
 	if (ch1_ready) ch1_ready_ramclock <= 0;
 	if (ch2_ready) ch2_ready_ramclock <= 0;
 	if (ch3_ready) ch3_ready_ramclock <= 0;
-	
+	if (ch4_ready) ch4_ready_ramclock <= 0;
+
 	if (dma_ack) dma_done <= 0;
 
 	if (dma_reqprocessed) dma_reqprocessed_ramclock <= 0;
@@ -262,6 +274,7 @@
 	data_ready_delay1 <= data_ready_delay1>>1;
 	data_ready_delay2 <= data_ready_delay2>>1;
 	data_ready_delay3 <= data_ready_delay3>>1;
+	data_ready_delay4 <= data_ready_delay4>>1;
 
 	dq_reg <= SDRAM_DQ;
    
@@ -301,6 +314,17 @@
 	if(data_ready_delay3[6]) ch3_dout[31:16]    <= dq_reg;
 	if(data_ready_delay3[2]) ch3_ready_ramclock <= 1;
 
+	// ch4: 128-bit flash line-fill burst capture (mirrors the ch1 cache read).
+	if(data_ready_delay4[7]) ch4_dout[ 15: 00] <= dq_reg;
+	if(data_ready_delay4[6]) ch4_dout[ 31: 16] <= dq_reg;
+	if(data_ready_delay4[5]) ch4_dout[ 47: 32] <= dq_reg;
+	if(data_ready_delay4[4]) ch4_dout[ 63: 48] <= dq_reg;
+	if(data_ready_delay4[3]) ch4_dout[ 79: 64] <= dq_reg;
+	if(data_ready_delay4[2]) ch4_dout[ 95: 80] <= dq_reg;
+	if(data_ready_delay4[1]) ch4_dout[111: 96] <= dq_reg;
+	if(data_ready_delay4[0]) ch4_dout[127:112] <= dq_reg;
+	if(data_ready_delay4[0]) ch4_ready_ramclock <= 1;
+
 	SDRAM_DQ <= 16'bZ;
    
    if (SDRAM_EN) begin
@@ -482,6 +506,17 @@
                ch3_rq     <= 0;
                command    <= CMD_ACTIVE;
                state      <= STATE_WAIT;
+            end else if(ch4_req | ch4_rq) begin
+               // System 573 flash line fill: read-only 128-bit burst, like the ch1
+               // cache read (8 words via the saved_128read burst sequence below).
+               {cas_addr[12:9],SDRAM_BA,SDRAM_A,cas_addr[8:0]} <= {2'b00, 1'b1, ch4_addr[25:1]};
+               chip          <= ch4_addr[26];
+               saved_wr      <= 1'b0;       // read only
+               ch            <= 3;
+               ch4_rq        <= 0;
+               command       <= CMD_ACTIVE;
+               state         <= STATE_WAIT;
+               saved_128read <= 1'b1;       // drive the 4x2-word burst issue
             end
          end
    
@@ -504,7 +539,8 @@
                state   <= STATE_IDLE_9;
                   if(ch == 0) data_ready_delay1[CAS_LATENCY+BURST_LENGTH] <= 1;
                else if(ch == 1) data_ready_delay2[CAS_LATENCY+BURST_LENGTH] <= 1;
-               else             data_ready_delay3[CAS_LATENCY+BURST_LENGTH] <= 1;
+               else if(ch == 2) data_ready_delay3[CAS_LATENCY+BURST_LENGTH] <= 1;
+               else             data_ready_delay4[CAS_LATENCY+BURST_LENGTH] <= 1;
             end
          end
    
