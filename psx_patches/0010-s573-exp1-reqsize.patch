diff --git a/rtl/memorymux.vhd b/rtl/memorymux.vhd
--- a/rtl/memorymux.vhd
+++ b/rtl/memorymux.vhd
@@ -61,6 +61,7 @@
       bus_exp1_write       : out std_logic;
       bus_exp1_dataRead    : in  std_logic_vector(15 downto 0);
       bus_exp1_wait        : in  std_logic;   -- System 573 flash line-fill stall
+      bus_exp1_reqsize     : out unsigned(1 downto 0);  -- 573: CPU load width (00=lb/lbu,01=lh/lhu,10=lw)
 
       bus_memc_addr        : out unsigned(5 downto 0);
       bus_memc_dataWrite   : out std_logic_vector(31 downto 0);
@@ -959,6 +960,10 @@
    -- write data. Normal 573 operation runs this bus 16-bit wide (ex1_memctrl bit
    -- 12 = 1); the read-data assembly below assumes that.
    bus_exp1_addr      <= ext_bus_addr;
+   -- System 573: export the latched CPU load width so the EXP1 SLAVE (system573_top.v)
+   -- can byte-align its 16-bit halfword-native read return. reqsize_buf is latched once
+   -- per transaction in IDLE (from mem_reqsize) and held stable through the EXT_* states.
+   bus_exp1_reqsize   <= reqsize_buf;
    bus_exp1_write     <= '1' when (ext_write_ena = '1' and ext_select_ex1_saved = '1') else '0';
    bus_exp1_read      <= '1' when (ext_state = EXT_READ_NEXT and ext_select_ex1_saved = '1') else '0';
    bus_exp1_dataWrite <= ext_dataWrite;
diff --git a/rtl/psx_top.vhd b/rtl/psx_top.vhd
