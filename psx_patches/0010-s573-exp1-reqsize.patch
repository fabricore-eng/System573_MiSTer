       exp_irq10             : in  std_logic;
       ram_refresh           : out std_logic;
       ram_dataWrite         : out std_logic_vector(31 downto 0);
@@ -333,6 +334,7 @@
    signal bus_exp1_write         : std_logic;
    signal bus_exp1_dataRead      : std_logic_vector(15 downto 0);
    signal bus_exp1_wait          : std_logic;
+   signal bus_exp1_reqsize       : unsigned(1 downto 0);
 
    signal bus_memc_addr          : unsigned(5 downto 0);
    signal bus_memc_dataWrite     : std_logic_vector(31 downto 0);
@@ -1739,6 +1741,7 @@
    exp1_re           <= bus_exp1_read;
    bus_exp1_dataRead <= exp1_dataRead;
    bus_exp1_wait     <= exp1_wait;   -- 573 flash line-fill stall -> memorymux
+   exp1_reqsize      <= bus_exp1_reqsize;   -- 573 CPU load width -> EXP1 slave byte-align
 
    imemorymux : entity work.memorymux
    port map
@@ -1797,6 +1800,7 @@
       bus_exp1_write       => bus_exp1_write,
       bus_exp1_dataRead    => bus_exp1_dataRead,
       bus_exp1_wait        => bus_exp1_wait,
+      bus_exp1_reqsize     => bus_exp1_reqsize,
 
       bus_memc_addr        => bus_memc_addr,     
       bus_memc_dataWrite   => bus_memc_dataWrite,
