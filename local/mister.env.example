# MiSTer connection config. Copy to `local/mister.env` and fill in.
# `local/` is git-ignored, so credentials/IPs stay out of the repo.
# The tools/mister_*.sh scripts read this file to load cores and pull screenshots/debug back.

# Hostname or IP of the MiSTer on your network
MISTER_HOST=mister   # ssh ALIAS (mister/ss1/de10) -- IPs live in ~/.ssh/config ONLY

# SSH user (MiSTer default is root) and auth. Prefer a key over a password.
MISTER_USER=root
MISTER_SSH_KEY=~/.ssh/mister_id_ed25519
# MISTER_PASSWORD=1            # MiSTer default password if not using a key

# Where cores live on the SD and where screenshots land
MISTER_CORE_DIR=/media/fat/_Console
MISTER_SHOT_DIR=/media/fat/screenshots

# The core's .rbf name once built
CORE_RBF=System573.rbf
